{
  "name": "dsh-prompt-pilot",
  "version": "2.1.1",
  "description": "Prompt Pilot for DeepSeek Harness: in-place draft enhancement, first-message mode advice, and tiered skill suggestions.",
  "type": "module",
  "icon": "icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asterdot/dsh-prompt-pilot.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "host/",
    "client.js",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt",
    "prompt-engineering",
    "dsh-plugin"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-locale": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "engines": {
    "dsh": ">=0.1.0",
    "node": ">=22.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "test": "node tests/test-host.mjs && node tests/test-advice.mjs && node tests/test-draft-math.mjs && node tests/test-settings.mjs && node tests/test-rules.mjs && node tests/test-composer-files.mjs && node tests/test-lifecycle.mjs && node tests/test-settings-client.mjs && node tests/test-host-contracts.mjs && node tests/test-shortcut-contract.mjs",
    "prepublishOnly": "npm run check && npm test",
    "pack": "node -e \"require('node:fs').mkdirSync('dist',{recursive:true})\" && npm pack --pack-destination dist"
  }
}
